<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>@ViewData["Title"] - ResumeCraft AI</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@500;600;700;800&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<nav class="navbar navbar-expand-lg app-nav">
  <div class="container">
    <a class="navbar-brand brand" asp-controller="Home" asp-action="Index"><span class="brand-mark">R</span> ResumeCraft <span class="ai-pill">AI</span></a>
    <div class="d-flex align-items-center gap-3">
      <a class="nav-link d-none d-md-inline" asp-controller="Resumes" asp-action="Index">My resumes</a>
      <partial name="_LoginPartial" />
    </div>
  </div>
</nav>
<main>@RenderBody()</main>
<footer class="footer"><div class="container d-flex justify-content-between flex-wrap gap-2"><span>ResumeCraft AI</span><span>Build your next chapter.</span></div></footer>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
